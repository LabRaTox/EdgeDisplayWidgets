{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EdgeDash",
  "mainBinaryName": "edgedash",
  "identifier": "app.labratox.edgedashboard",
  "version": "1.5.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EDGE//DASH",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Einstellungen für das Edge Dashboard",
    "longDescription": "EDGE//DASH — Einstellungen für das Edge Dashboard auf dem Corsair Xeneon Edge: Design, Module, Quick Actions und Seitenlayout.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
